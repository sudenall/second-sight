---
import { getCollection, render } from "astro:content";
import Layout from "../../components/Layout.astro";
import T from "../../components/T.astro";
import NoteTitle from "../../components/NoteTitle.astro";
import { parseWikilinkString } from "../../lib/wikilinks.mjs";
import { slugify } from "../../lib/slug";

export async function getStaticPaths() {
  const concepts = await getCollection("concepts");
  return concepts.map((c) => ({
    params: { slug: c.id },
    props: { entry: c },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const sessionLink = parseWikilinkString(entry.data.parent_session);
const sessions = await getCollection("sessions");
const sessionEntry = sessionLink ? sessions.find((s) => s.id === sessionLink.target) : undefined;
---

<Layout title={entry.data.title}>
  <p class="mb-4 text-sm">
    <a href={`/categories/${slugify(entry.data.category)}/`}>&larr; {entry.data.category}</a>
  </p>

  <h1 class="mb-2 text-2xl font-bold">
    <NoteTitle tr={entry.data.title} en={entry.data.title_en} />
  </h1>

  <div class="mb-6 flex flex-wrap gap-2 text-xs text-ink-muted">
    <span class="badge border border-border">{entry.data.category}</span>
    <span class="badge border border-border">{entry.data.subcategory}</span>
    {entry.data.difficulty && <span class="badge border border-border">{entry.data.difficulty}</span>}
    {entry.data.date_learned && <span class="badge border border-border">{entry.data.date_learned}</span>}
    {
      entry.data.tags.map((tag) => (
        <span class="badge bg-bg-softer text-accent-soft">#{tag}</span>
      ))
    }
  </div>

  {
    sessionEntry && (
      <p class="mb-6 text-sm text-ink-muted">
        <T k="source_session" />:{" "}
        <a href={`/sessions/${sessionEntry.id}/`}>
          <NoteTitle tr={sessionEntry.data.title} en={sessionEntry.data.title_en} />
        </a>
      </p>
    )
  }

  <article class="prose-note">
    <Content />
  </article>
</Layout>
