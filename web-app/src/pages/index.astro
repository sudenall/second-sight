---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import DailyReminders from "../components/DailyReminders.astro";
import RetrospectiveTables from "../components/RetrospectiveTables.astro";
import T from "../components/T.astro";
import { slugify } from "../lib/slug";
import { flattenNoteEntries } from "../lib/flatten-entries";

const allNotes = await getCollection("notes");
const entries = flattenNoteEntries(allNotes);

const categories = Array.from(new Set(allNotes.map((n) => n.data.category))).sort();
---

<Layout title="Ana Sayfa">
  <DailyReminders entries={entries} />
  <RetrospectiveTables entries={entries} />

  <section class="card">
    <h2 class="mb-3 text-base font-semibold"><T k="categories_title" /></h2>
    <ul class="flex flex-wrap gap-2">
      {
        categories.map((cat) => (
          <li>
            <a
              href={`/categories/${slugify(cat)}/`}
              class="badge border border-border bg-bg-softer text-ink no-underline hover:border-accent hover:text-accent"
            >
              {cat}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
