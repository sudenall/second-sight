---
import { getCollection, render } from "astro:content";
import Layout from "../../components/Layout.astro";
import NoteTitle from "../../components/NoteTitle.astro";
import { slugify } from "../../lib/slug";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((n) => ({
    params: { slug: n.id },
    props: { entry: n },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
  <p class="mb-4 text-sm">
    <a href={`/categories/${slugify(entry.data.category)}/`}>&larr; {entry.data.category}</a>
  </p>

  <h1 class="mb-2 text-2xl font-bold">
    <NoteTitle tr={entry.data.title} en={entry.data.title_en} />
  </h1>

  <div class="mb-6 flex flex-wrap gap-2 text-xs text-ink-muted">
    <span class="badge border border-border">{entry.data.category}</span>
    <span class="badge border border-border">{entry.data.subcategory}</span>
    {
      entry.data.tags.map((tag) => (
        <span class="badge bg-bg-softer text-accent-soft">#{tag}</span>
      ))
    }
  </div>

  {
    entry.data.entries.length > 0 && (
      <div class="mb-6 flex flex-wrap gap-2 text-xs text-ink-muted">
        {entry.data.entries.map((e) => (
          <span class="badge border border-border" title={e.label}>
            {e.date || "?"}
          </span>
        ))}
      </div>
    )
  }

  <article class="prose-note lang-tr-block">
    <Content />
  </article>
  <article class="prose-note lang-en-block" hidden set:html={entry.data.enHtml} />
</Layout>
