---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import T from "../../components/T.astro";
import NoteTitle from "../../components/NoteTitle.astro";
import { slugify } from "../../lib/slug";

export async function getStaticPaths() {
  const allNotes = await getCollection("notes");
  const categories = Array.from(new Set(allNotes.map((n) => n.data.category)));
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { categoryName: category },
  }));
}

const { categoryName } = Astro.props;
const allNotes = await getCollection("notes");
const inCategory = allNotes.filter((n) => n.data.category === categoryName);

function latestDate(entries: { date: string }[]) {
  const dates = entries.map((e) => e.date).filter(Boolean);
  return dates.length ? dates.sort().at(-1)! : "";
}

const bySubcategory = new Map<string, typeof inCategory>();
for (const n of inCategory) {
  const key = n.data.subcategory || "—";
  if (!bySubcategory.has(key)) bySubcategory.set(key, []);
  bySubcategory.get(key)!.push(n);
}
const subcategories = Array.from(bySubcategory.keys()).sort();
---

<Layout title={categoryName}>
  <p class="mb-4 text-sm">
    <a href="/">&larr; <T k="back_to_home" /></a>
  </p>
  <h1 class="mb-6 text-2xl font-bold">{categoryName}</h1>

  {
    subcategories.map((sub) => {
      const items = bySubcategory
        .get(sub)!
        .slice()
        .sort((a, b) => (latestDate(a.data.entries) < latestDate(b.data.entries) ? 1 : -1));
      return (
        <section class="mb-8">
          <h2 class="mb-3 border-b border-border pb-1 text-lg font-semibold">
            {sub} <span class="text-sm font-normal text-ink-faint">({items.length})</span>
          </h2>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[480px] border-collapse text-sm">
              <thead>
                <tr>
                  <th class="border border-border bg-bg-softer px-2 py-1 text-left">
                    <T k="note_label" />
                  </th>
                  <th class="border border-border bg-bg-softer px-2 py-1 text-left">
                    <T k="tags_label" />
                  </th>
                  <th class="border border-border bg-bg-softer px-2 py-1 text-left">
                    <T k="entries_count_label" />
                  </th>
                  <th class="border border-border bg-bg-softer px-2 py-1 text-left">
                    <T k="last_updated_label" />
                  </th>
                </tr>
              </thead>
              <tbody>
                {items.map((n) => (
                  <tr>
                    <td class="border border-border px-2 py-1">
                      <a href={`/notes/${n.id}/`}>
                        <NoteTitle tr={n.data.title} en={n.data.title_en} />
                      </a>
                    </td>
                    <td class="border border-border px-2 py-1">
                      {n.data.tags.length > 0 ? n.data.tags.map((t) => `#${t}`).join(" ") : "—"}
                    </td>
                    <td class="border border-border px-2 py-1">{n.data.entries.length}</td>
                    <td class="border border-border px-2 py-1">{latestDate(n.data.entries) || "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      );
    })
  }
</Layout>
