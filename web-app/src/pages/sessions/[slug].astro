---
import { getCollection, render } from "astro:content";
import Layout from "../../components/Layout.astro";
import T from "../../components/T.astro";
import NoteTitle from "../../components/NoteTitle.astro";
import { slugify } from "../../lib/slug";

export async function getStaticPaths() {
  const sessions = await getCollection("sessions");
  return sessions.map((s) => ({
    params: { slug: s.id },
    props: { entry: s },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allConcepts = await getCollection("concepts");
const sessionConcepts = allConcepts.filter((c) => c.data.parent_session.includes(entry.id));
---

<Layout title={entry.data.title}>
  <p class="mb-4 text-sm">
    <a href={`/categories/${slugify(entry.data.category)}/`}>&larr; {entry.data.category}</a>
  </p>

  <h1 class="mb-2 text-2xl font-bold">
    <NoteTitle tr={entry.data.title} en={entry.data.title_en} />
  </h1>

  <div class="mb-6 flex flex-wrap gap-2 text-xs text-ink-muted">
    <span class="badge border border-border">{entry.data.category}</span>
    <span class="badge border border-border">{entry.data.subcategory}</span>
    {entry.data.date_learned && <span class="badge border border-border">{entry.data.date_learned}</span>}
  </div>

  <article class="prose-note">
    <Content />
  </article>

  {
    sessionConcepts.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-2 text-lg font-semibold">
          <T k="session_concepts" />
        </h2>
        <ul class="list-disc space-y-1 pl-5 text-sm">
          {sessionConcepts.map((c) => (
            <li>
              <a href={`/concepts/${c.id}/`}>
                <NoteTitle tr={c.data.title} en={c.data.title_en} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
